{
    "name": "sunet/integration_oidc",
    "description": "Easily integrate OIDC providers",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "autoload": {
        "psr-4": {
            "OCA\\IOIDC\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\IOIDC\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Micke Nordin",
            "email": "kano@sunet.se"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-openssl": "*",
        "firebase/php-jwt": "^7.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "nextcloud/ocp": "28.0.9",
        "phpunit/phpunit": "^10.5"
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    },
    "scripts": {
        "cs:fix": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "test": "phpunit -c phpunit.xml"
    }
}
